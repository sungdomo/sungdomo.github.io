---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found" currentPath="/404">
  <section style="padding-block: 3rem; text-align: center;">
    <h1 class="page-title">404</h1>
    <p class="page-subtitle" style="margin-inline: auto;">
      The page you are looking for does not exist or has been moved.
    </p>
    <a href="/" class="social-pill" style="display: inline-flex;">
      <span>&larr; Return to Home</span>
    </a>
  </section>
</BaseLayout>
